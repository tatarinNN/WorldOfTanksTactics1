<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/____"
    tools:context=".MainActivitySettings">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/safe_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glSplit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.48" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/glSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/exitToMenub"
                        style="@style/GameButton"
                        android:layout_width="44dp"
                        android:layout_height="40dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="✕"
                        android:textColor="#FF8A7A"
                        tools:ignore="HardcodedText" />

                    <TextView
                        style="@style/GameTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/game_settings_title"
                        android:textSize="22sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/voice_sw"
                    style="@style/GameSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/game_voice_switch" />

                <TextView
                    style="@style/GameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/game_music_label"
                    android:textColor="@color/game_brass_light"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/music_sw"
                    style="@style/GameSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/game_music_switch" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnMusicRecommended"
                        style="@style/GameButton.Small"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/game_music_recommended" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnMusicCustom"
                        style="@style/GameButton.Small"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/game_music_custom" />
                </LinearLayout>

                <TextView
                    style="@style/GameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/game_music_volume"
                    android:textColor="@color/game_text_dim"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/musicVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progressBackgroundTint="#5A5048"
                    android:progressTint="@color/game_brass_light"
                    android:thumbTint="@color/game_brass_light" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnMusicLibrary"
                    style="@style/GameButton.Small"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/game_music_library" />

                <TextView
                    style="@style/GameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Прочее"
                    android:textColor="@color/game_brass_light"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/languagesw"
                    style="@style/GameSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Язык (РУС/АНГЛ)"
                    tools:ignore="HardcodedText" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/mat_sw"
                    style="@style/GameSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Цензура (Выкл/Вкл)"
                    tools:ignore="HardcodedText" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/all_roots_sw2"
                    style="@style/GameSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Вымышленные концовки (Вкл/Выкл)"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/SlozhnostConst"
                    style="@style/GameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Сложность:"
                    android:textColor="@color/game_brass_light"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/easyb"
                        style="@style/GameButton.Small"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="Легко"
                        tools:ignore="HardcodedText" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/normalb"
                        style="@style/GameButton.Small"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="Норма"
                        tools:ignore="HardcodedText" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/hardb"
                        style="@style/GameButton.Small"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Сложно"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <TextView
                    android:id="@+id/VibranaSlozhnost"
                    style="@style/GameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Выбрана сложность: нормальная"
                    android:textColor="@color/game_text_dim"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </ScrollView>

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/history_of_pictures_1948"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/glSplit"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/__2___" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
