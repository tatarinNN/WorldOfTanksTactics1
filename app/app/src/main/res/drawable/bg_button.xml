<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFD27A">
    <item>
        <selector>
            <!-- выбранная (пол в анкете, сложность) -->
            <item android:state_selected="true">
                <layer-list>
                    <item><shape><corners android:radius="5dp" /><solid android:color="#0E0C0B" /></shape></item>
                    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2dp">
                        <shape>
                            <corners android:radius="4dp" />
                            <gradient android:angle="270" android:startColor="#8A7444" android:endColor="#4E3F22" />
                            <stroke android:width="1.5dp" android:color="@color/game_brass_light" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:state_pressed="true">
                <layer-list>
                    <item><shape><corners android:radius="5dp" /><solid android:color="#0E0C0B" /></shape></item>
                    <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="1dp">
                        <shape>
                            <corners android:radius="4dp" />
                            <gradient android:angle="270" android:startColor="#2B2724" android:endColor="#3F3934" />
                            <stroke android:width="1.5dp" android:color="@color/game_brass_light" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:state_enabled="false">
                <layer-list>
                    <item><shape><corners android:radius="5dp" /><solid android:color="#0E0C0B" /></shape></item>
                    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2dp">
                        <shape>
                            <corners android:radius="4dp" />
                            <solid android:color="#2A2725" />
                            <stroke android:width="1dp" android:color="#4A443C" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item><shape><corners android:radius="5dp" /><solid android:color="#0E0C0B" /></shape></item>
                    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2dp">
                        <shape>
                            <corners android:radius="4dp" />
                            <gradient android:angle="270" android:startColor="@color/game_steel_top" android:endColor="@color/game_steel_bottom" />
                            <stroke android:width="1.5dp" android:color="@color/game_brass" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
